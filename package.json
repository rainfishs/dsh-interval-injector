{
  "name": "interval-injector",
  "version": "0.2.0",
  "description": "A generic periodic context injector for DSH/Cordis agents: re-inject a block of text into the conversation every N steps or N minutes.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "cordis",
    "cordis-plugin",
    "dsh-bundle",
    "agent",
    "context",
    "injector"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
